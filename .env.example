# ============================================================================
# Hagen-ID: Beispiel-Umgebungsvariablen
# ============================================================================
# Kopiere nach .env und passe die Werte an!
# 
# WICHTIG: .env niemals committen! (ist in .gitignore)
# ============================================================================

# =============================================================================
# DATENBANK
# =============================================================================
# Für Docker Compose (lokale Entwicklung)
DB_PASSWORD=hagenid_dev_password

# Für Coolify/Produktion: Vollständige URL
# DATABASE_URL=postgresql://user:password@host:5432/dbname


# =============================================================================
# JWT AUTHENTIFIZIERUNG
# =============================================================================
# WICHTIG: MUSS gesetzt werden (min. 32 Zeichen). Der Platzhalter unten ist
# absichtlich zu kurz — ohne echten Wert startet die App in Produktion nicht.
# Generieren mit: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME

# Token-Gültigkeit in Minuten (Standard: 7 Tage = 10080 Minuten)
JWT_EXPIRE_MINUTES=10080


# =============================================================================
# CORS (Cross-Origin Resource Sharing)
# =============================================================================
# Kommagetrennte Liste der erlaubten Origins
# Lokale Entwicklung:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# Produktion (Coolify-Domains):
# ALLOWED_ORIGINS=https://admin.example.com,https://app.example.com

# Anzahl vertrauenswürdiger Reverse-Proxys, die X-Forwarded-For anhängen.
# Coolify/Traefik: 1. Falsch gesetzt → Rate-Limiting greift auf die Proxy-IP
# statt die echte Client-IP (bzw. wäre über gefälschte Header umgehbar).
TRUSTED_PROXY_HOPS=1

# =============================================================================
# COOKIE-DOMAIN (für Cross-Subdomain Admin-Auth)
# =============================================================================
# Nur setzen wenn Admin-Frontend und API auf verschiedenen Subdomains laufen.
# Beispiel: Admin auf admin.example.com, API auf api.example.com → COOKIE_DOMAIN=.example.com
# Nicht setzen für localhost-Entwicklung!
# COOKIE_DOMAIN=.example.com

# Cookie Secure-Flag (false für lokale Entwicklung ohne HTTPS)
# COOKIE_SECURE=false

# =============================================================================
# SEED-DATEN (nur bei erstem Start / leerem DB)
# =============================================================================
# DEFAULT_ADMIN_EMAIL=admin@example.com
# DEFAULT_SUPERADMIN_EMAIL=superadmin@example.com
# DEFAULT_ADMIN_PASSWORD=   # leer lassen → zufälliges Passwort wird generiert und EINMALIG im Log ausgegeben


# =============================================================================
# FELD-VERSCHLÜSSELUNG AT-REST
# =============================================================================
# Verschlüsselt PII, login_pin und totp_secret in der DB (Fernet). Der Key liegt
# HIER (Env), nicht in der DB → ein reiner DB-Dump ist damit wertlos. NICHT
# setzen = Klartext (Passthrough, z.B. Dev). Beim ersten Start mit Key wird
# Altbestand automatisch verschlüsselt (idempotent).
# Key erzeugen: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# WICHTIG: Key sicher aufbewahren! Verlust = Daten nicht mehr entschlüsselbar.
# SECRETS_KEY=

# --- Mandantentrennung per Postgres Row-Level-Security ---
# true = die App erzwingt die Schul-Trennung auf DB-Ebene (empfohlen für Prod).
# Beim Start werden Rolle/Grants/Policies idempotent angelegt. Nur Postgres.
# Kill-Switch bei Problemen: RLS_ENABLED=false (kein Code-Deploy nötig).
# RLS_ENABLED=true

# =============================================================================
# RATE LIMITING (Brute-Force-Schutz)
# =============================================================================
# DB-basiert (neustart-/worker-fest); Lockout pro Konto UND pro IP.
# Werte werden mit harten Grenzen geklemmt: attempts 3..20, window 5..120 min
# (der Schutz lässt sich also nicht wegkonfigurieren).
RATE_LIMIT_ATTEMPTS=5
RATE_LIMIT_WINDOW_MINUTES=15


# =============================================================================
# DEBUG (nur Entwicklung!)
# =============================================================================
# SQL-Queries im Log anzeigen
SQL_DEBUG=false
